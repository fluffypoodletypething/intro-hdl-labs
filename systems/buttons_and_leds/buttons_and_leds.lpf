## ULX3S (v2.x / v3.x) constraints for buttons_and_leds
##
## Pin assignments are from the ULX3S templace lpf file:
##   https://github.com/emard/ulx3s/blob/master/doc/constraints/ulx3s_v20.lpf
##
## The ULX3S has a 25 MHz oscillator on G2, eight discrete LEDs,
## and seven pushbuttons. Button 0 is the power button: it is active-low
## and has a pull-up, which is why the design uses rst = ~buttons[0].
## The other six buttons are active-high with pull-downs.

## 25 MHz board oscillator
LOCATE COMP "clk" SITE "G2";
IOBUF  PORT "clk" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

## Pushbuttons
## buttons[0] = BTN_PWRn (active-low, pull-up)
## buttons[1] = FIRE1
## buttons[2] = FIRE2
## buttons[3] = UP
## buttons[4] = DOWN
## buttons[5] = LEFT
## buttons[6] = RIGHT
LOCATE COMP "buttons[0]" SITE "D6";  # BTN_PWRn
LOCATE COMP "buttons[1]" SITE "R1";  # FIRE1
LOCATE COMP "buttons[2]" SITE "T1";  # FIRE2
LOCATE COMP "buttons[3]" SITE "R18"; # UP
LOCATE COMP "buttons[4]" SITE "V1";  # DOWN
LOCATE COMP "buttons[5]" SITE "U1";  # LEFT
LOCATE COMP "buttons[6]" SITE "H16"; # RIGHT
IOBUF PORT "buttons[0]" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "buttons[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "buttons[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "buttons[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "buttons[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "buttons[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "buttons[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;

## Discrete LEDs
LOCATE COMP "leds[0]" SITE "B2";
LOCATE COMP "leds[1]" SITE "C2";
LOCATE COMP "leds[2]" SITE "C1";
LOCATE COMP "leds[3]" SITE "D2";
LOCATE COMP "leds[4]" SITE "D1";
LOCATE COMP "leds[5]" SITE "E2";
LOCATE COMP "leds[6]" SITE "E1";
LOCATE COMP "leds[7]" SITE "H3";
IOBUF PORT "leds[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "leds[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

## Configuration: 3.3 V I/O and boot from SPI flash.
## fujprog can still load a bitstream into SRAM without touching flash.
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;
